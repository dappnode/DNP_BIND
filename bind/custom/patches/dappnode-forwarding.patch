+// fallbackResponse preserves Dappnode's forwarding fallback when the local
+// resolver cannot answer, for example when resolving an unknown .eth name.
+func (plugin *PluginForward) fallbackResponse(msg *dns.Msg, target string) *dns.Msg {
+	response := EmptyResponseFromMessage(msg)
+	if len(msg.Question) == 0 {
+		return response
+	}
+	header := dns.Header{
+		Name: msg.Question[0].Header().Name, Class: dns.ClassINET, TTL: plugin.fallbackTTL,
+	}
+	if ip, err := netip.ParseAddr(target); err == nil {
+		qtype := dns.RRToType(msg.Question[0])
+		if ip.Is4() && qtype == dns.TypeA {
+			response.Answer = []dns.RR{&dns.A{Hdr: header, A: rdata.A{Addr: ip}}}
+		} else if ip.Is6() && qtype == dns.TypeAAAA {
+			response.Answer = []dns.RR{&dns.AAAA{Hdr: header, AAAA: rdata.AAAA{Addr: ip}}}
+		}
+	} else {
+		response.Answer = []dns.RR{&dns.CNAME{
+			Hdr: header, CNAME: rdata.CNAME{Target: strings.TrimSuffix(target, ".") + "."},
+		}}
+	}
+	return response
+}
